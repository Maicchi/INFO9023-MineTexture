FROM python:3.11-slim AS builder
WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

# Install training deps
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --group train

# Clone sd-scripts and install in venv
RUN git clone --depth 1 https://github.com/kohya-ss/sd-scripts.git /app/sd-scripts
RUN uv pip install --python /app/.venv/bin/python -r /app/sd-scripts/requirements.txt
RUN uv pip install --python /app/.venv/bin/python -e /app/sd-scripts

FROM python:3.11-slim
WORKDIR /app

# Install gcloud CLI, envsubst, libglib2
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl gnupg gettext-base libgl1 libglib2.0-0 && \
    curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
      | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
      > /etc/apt/sources.list.d/google-cloud-sdk.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends google-cloud-cli && \
    apt-get purge -y gnupg && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# Copy virtual environment and sd-scripts from builder
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/sd-scripts /app/sd-scripts

# Copy only the training files needed at runtime
COPY scripts/training/training.sh /app/training.sh
COPY scripts/training/training_config.toml /app/training_config.toml

# Use the virtual environment
ENV PATH="/app/.venv/bin:$PATH"

RUN chmod +x /app/training.sh
CMD ["bash", "/app/training.sh"]
